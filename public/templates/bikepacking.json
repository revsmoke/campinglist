        {"text": "Merino leggings or sleep layer", "required": false, "permitRequired": false},
        {"text": "Beanie and neck gaiter", "required": false, "permitRequired": false},
        {"text": "Rain pants and warm gloves for cold or wet routes", "required": false, "permitRequired": false},
        {"text": "Camp sandals", "required": false, "permitRequired": false},
        {"text": "High-visibility vest for hunting season or paved sections", "required": false, "permitRequired": false}
      ]
    },
    {
      "title": "Safety & First Aid",
      "items": [
