{
  "id": "bikepacking",
  "name": "Bikepacking",
  "category": "style",
  "tagline": "For riders carrying camp on the bike for multi-day routes over dirt, gravel, and pavement.",
  "description": "A starting point for 2-7 night self-supported bikepacking trips on mixed surfaces, resupplying in towns every day or two. Assumes a tubeless-ready bike with frame, seat, and handlebar bags, camping at dispersed sites or campgrounds, and cooking simple meals. Adapt spares to the terrain, water and food capacity to the longest gap between resupply points, and insulation to the season.",
  "season": "Spring-Fall",
  "typicalDuration": "2-7 nights",
  "considerations": [
    "Research the route: water sources, resupply towns, surfaces, and climbing; load GPX tracks on a GPS unit and your phone.",
    "Check current land rules along the route; bikes are prohibited in designated Wilderness and on some trails.",
    "Check current fire restrictions and whether dispersed camping is allowed where you plan to stop.",
    "Check hunting seasons along the route and carry blaze orange where needed.",
    "Cell coverage is spotty; carry a satellite messenger on remote routes and tell someone your plan.",
    "Check current bear-country food-storage rules along the route."
  ],
  "reviewedOn": "2026-10-07",
  "sources": [
    {"title": "Bikepacking 101: What to Pack", "publisher": "BIKEPACKING.com", "url": "https://bikepacking.com/bikepacking-101/pack-list/", "accessed": "2026-10-07"},
    {"title": "The 10 Essentials", "publisher": "National Park Service", "url": "https://www.nps.gov/articles/10essentials.htm", "accessed": "2026-10-07"},
    {"title": "Leave No Trace Seven Principles", "publisher": "National Park Service", "url": "https://www.nps.gov/articles/leave-no-trace-seven-principles.htm", "accessed": "2026-10-07"},
    {"title": "Food Storage in Bear Country", "publisher": "National Park Service", "url": "https://home.nps.gov/articles/bearsafetyfood.htm", "accessed": "2026-10-07"}
