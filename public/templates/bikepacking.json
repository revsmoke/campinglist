  "sections": [
    {
      "title": "Planning & Navigation",
      "items": [
        {"text": "Route GPX loaded on a GPS unit and phone with offline maps", "required": true, "permitRequired": false},
        {"text": "Backup paper map or printed cue sheet", "required": true, "permitRequired": false},
        {"text": "Resupply and water plan by day", "required": true, "permitRequired": false},
        {"text": "Trip plan shared with someone at home", "required": true, "permitRequired": false},
        {"text": "Battery bank (10,000 mAh or more) and cables, or a dynamo hub", "required": true, "permitRequired": false},
        {"text": "Permits or reservations for campgrounds and parks on the route", "required": false, "note": "Check current rules for each land unit you cross.", "permitRequired": true},
        {"text": "Handlebar mount for GPS or phone", "required": false, "permitRequired": false},
        {"text": "Wall charger for town stops", "required": false, "permitRequired": false}
      ]
    },
    {
      "title": "Bike & Bags",
      "items": [
        {"text": "Bike tuned up: brakes, drivetrain, bearings, and tires checked", "required": true, "permitRequired": false},
        {"text": "Helmet", "required": true, "permitRequired": false},
        {"text": "Frame, seat, and handlebar bags (or racks and panniers)", "required": true, "permitRequired": false},
        {"text": "Front light and rear blinker", "required": true, "permitRequired": false},
        {"text": "Bottle cages or other water mounts", "required": true, "permitRequired": false},
        {"text": "Bell for warning hikers", "required": false, "permitRequired": false},
        {"text": "Lightweight lock for town stops", "required": false, "permitRequired": false},
        {"text": "Extra cargo straps and dry bags", "required": false, "permitRequired": false}
      ]
    },
    {
      "title": "Repair Kit & Spares",
      "items": [
        {"text": "Mini pump (high volume)", "required": true, "permitRequired": false},
        {"text": "Multi-tool with the Allen and Torx bits your bike needs, plus chain breaker", "required": true, "permitRequired": false},
        {"text": "Tire levers", "required": true, "permitRequired": false},
        {"text": "Spare tube(s), 1-2", "required": true, "permitRequired": false},
        {"text": "Tubeless plugs and extra sealant (if tubeless)", "required": true, "permitRequired": false},
        {"text": "Patch kit and tire boot", "required": true, "permitRequired": false},
        {"text": "Quick links that match your chain", "required": true, "permitRequired": false},
        {"text": "Spare derailleur hanger", "required": true, "permitRequired": false},
        {"text": "Chain lube and a rag", "required": true, "permitRequired": false},
        {"text": "Zip ties and duct tape", "required": true, "permitRequired": false},
        {"text": "Spare brake pads", "required": false, "note": "Bring a set or two on longer, wetter, or steeper routes.", "permitRequired": false},
        {"text": "Spare bolts (rack, cleat, seatpost)", "required": false, "permitRequired": false},
        {"text": "Spare spokes, nipples, and spoke wrench", "required": false, "permitRequired": false},
        {"text": "Shock pump (if suspension)", "required": false, "permitRequired": false},
        {"text": "Needle, thread, and super glue", "required": false, "permitRequired": false},
        {"text": "Spare shifter or brake cable", "required": false, "permitRequired": false}
      ]
    },
    {
      "title": "Shelter & Sleep",
      "items": [
        {"text": "Ultralight tent, tarp, or bivy", "required": true, "permitRequired": false},
        {"text": "Sleeping bag or quilt rated for the lows", "required": true, "permitRequired": false},
        {"text": "Sleeping pad (inflatable or foam)", "required": true, "permitRequired": false},
        {"text": "Inflatable pillow", "required": false, "permitRequired": false},
        {"text": "Groundsheet", "required": false, "permitRequired": false}
      ]
    },
    {
      "title": "Kitchen & Water",
      "items": [
        {"text": "Stove (canister or alcohol) and fuel", "required": true, "note": "Going stoveless is an option on routes with frequent towns.", "permitRequired": false},
        {"text": "Pot (0.7-1 L) and spork", "required": true, "permitRequired": false},
        {"text": "Lighter", "required": true, "permitRequired": false},
        {"text": "Water capacity (2-6 L) sized to the longest dry stretch", "required": true, "permitRequired": false},
        {"text": "Water filter or purification tablets", "required": true, "permitRequired": false},
        {"text": "Food for the days between resupply, plus snacks", "required": true, "permitRequired": false},
        {"text": "Mug and coffee kit", "required": false, "permitRequired": false},
        {"text": "Bear hang kit or canister where required", "required": false, "note": "Check current food-storage rules for each land unit on the route.", "permitRequired": false}
      ]
    },
    {
