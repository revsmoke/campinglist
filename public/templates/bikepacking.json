        {"text": "Shoes matched to your pedals", "required": true, "permitRequired": false},
        {"text": "Wool socks (2 pairs)", "required": true, "permitRequired": false},
        {"text": "Lightweight rain jacket", "required": true, "permitRequired": false},
        {"text": "Insulating jacket (down or synthetic)", "required": true, "permitRequired": false},
