{
  "id": "camplist-classic",
  "name": "Classic CampList (all-round car camping)",
  "category": "general",
  "tagline": "The original CampList: a complete pre-trip script plus gear for a typical drive-in campground trip.",
  "description": "A general-purpose list for a weekend to a week of car camping at a developed or semi-developed campground. It covers planning tasks, shelter, kitchen, clothing, first aid, hygiene, navigation, tools and campfire gear. Trim sections you do not need and add trip-specific items from the other templates.",
  "season": "Spring-Fall",
  "typicalDuration": "2-7 nights",
  "considerations": [
    "Check the campground's current fire restrictions and firewood rules before you buy or bring wood.",
    "Confirm reservation, quiet-hours and check-in rules for your specific campground; they vary by season.",
    "Review the weather forecast 48 hours before departure and adjust clothing and shelter accordingly.",
    "Food-storage rules (bears, raccoons) differ by region; follow posted guidance at your site."
  ],
