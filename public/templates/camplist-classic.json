  "sections": [
    {
      "title": "Pre-Trip Planning Script",
      "items": [
        {
          "text": "Pick destination & reserve campsite",
          "required": true
        },
        {
          "text": "Check permit rules (fires, fishing, drones)",
          "required": true
        },
        {
          "text": "Verify seasonal hazards (bears, fire bans, bugs)",
          "required": true
        },
        {
          "text": "Inspect/repair tent, stakes, zippers",
          "required": true
        },
        {
          "text": "Test camp-stove & fuel canisters",
          "required": true
        },
        {
          "text": "Create shared food plan & divide groceries",
          "required": true
        },
        {
          "text": "Check 7-day weather forecast & adjust clothing",
          "required": true
        },
        {
          "text": "Download offline maps & GPX route",
          "required": true
        },
        {
          "text": "Charge power banks, camera batteries, headlamps",
          "required": true
        },
        {
          "text": "Freeze one gallon of drinking water (acts as ice)",
          "required": false
        },
        {
          "text": "Pre-pack cooler & label meal bags",
          "required": true
        },
        {
          "text": "Put house on away-mode (thermostat, trash, mail)",
          "required": true
        },
        {
          "text": "Turn off stove, lock doors, set alarm",
          "required": true
        }
      ]
    },
    {
