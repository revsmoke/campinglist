entrypoint = "server/index.mjs"
modules = ["web", "nodejs-20"]

[nix]
channel = "stable-24_11"

# Autoscale deployment: server/index.mjs serves public/ and the trip wizard's judge endpoint
# (POST /api/judge), which forwards to TypeSafe with the TYPESAFE_API_KEY secret. Replit makes
# App Secrets available to Autoscale deployments (not to static ones); the key is read from the
# environment and never written to the repository. Only public/ is served; docs, tests and
# node_modules never leave the server. The server sets the security headers itself (nosniff,
# Referrer-Policy, X-Frame-Options, Permissions-Policy); CSP stays a <meta> tag in each page.
[deployment]
deploymentTarget = "autoscale"
run = ["node", "server/index.mjs"]

[[ports]]
localPort = 3000
externalPort = 80

[workflows]
runButton = "Serve"

[[workflows.workflow]]
name = "Serve"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server/index.mjs"
waitForPort = 3000
