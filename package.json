{
  "name": "camplist",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "CampList (camplist.guide): a free camping checklist planner. Static web app, no build step.",
  "license": "ISC",
  "scripts": {
    "start": "http-server public -p 8080 -c-1",
    "lint": "eslint .",
    "format": "prettier --write \"public/**/*.{js,css,html}\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"public/**/*.{js,css,html}\" \"tests/**/*.js\" \"scripts/**/*.mjs\" \"*.{js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "templates:validate": "node scripts/validate-templates.mjs",
    "templates:index": "node scripts/build-template-index.mjs",
    "vendor": "node scripts/vendor.mjs",
    "check": "npm run lint && npm run templates:validate && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "dompurify": "^3.4.16",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
